{
  "name": "@bigflower/pro-mobile",
  "version": "1.1.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "Reusable React components built on Ant Design Mobile.",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.lib.json",
    "build:demo": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@bigflower/utils": "^1.0.0",
    "antd-mobile": "^5.42.3",
    "antd-mobile-icons": "^0.3.0",
    "dayjs": "^1.11.21",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@bigflower/utils": "^1.1.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^0.24.0",
    "rc-field-form": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-lib-inject-css": "^2.2.2"
  }
}
